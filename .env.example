# ─── This file configures the CLI and the deploy. It holds no secrets. ────────
# Authentication is SigV4 from your ambient AWS credentials; the deployed
# components assume IAM roles. Never put an access key in here.
#
# Most runtime configuration is NOT here — it comes from the deployed stack's
# outputs (Gateway ARN, table names, Runtime ARN). There is no local mode, so
# there is nothing to configure for one. See ADR-017.

# ─── Target account and region ────────────────────────────────────────────────
# Choose a region where BOTH Amazon Bedrock AgentCore and your chosen Claude
# model are available. The stack is regional; cross-region AgentCore is not a
# supported topology here.
AWS_REGION=us-west-2
PII_ERASURE_STAGE=dev
PII_ERASURE_STACK_PREFIX=asdp
PII_ERASURE_TENANT=meridian

# ─── Model ────────────────────────────────────────────────────────────────────
# REQUIRED — there is deliberately no default. The correct value depends on your
# region and on which models your account has been granted access to (Bedrock
# requires per-account, per-model opt-in). List what is actually available:
#
#   aws bedrock list-inference-profiles --region "$AWS_REGION"
#
# Then paste the inference profile ID for a current Claude Sonnet or Opus model.
# langchain-aws ChatBedrockConverse uses the bedrock-runtime Converse API, whose
# identifiers are region-prefixed cross-region inference profiles.
# A wrong or unentitled ID deploys cleanly and then fails at discovery time.
PII_ERASURE_MODEL_ID=

# ─── Policy (ADR-018) ─────────────────────────────────────────────────────────
# LOG_ONLY records what WOULD have been denied without blocking. Always start
# here, run the eval corpus, and flip only when the deny set is empty against
# known-good trajectories (ARCHITECTURE §9.4). This is a stack parameter, so
# flipping it is a deploy and lands in CloudTrail.
PII_ERASURE_POLICY_MODE=LOG_ONLY

# ─── Timers (ADR-016: EventBridge Scheduler owns wall-clock) ──────────────────
# Real deployments use 2592000 (30 days). Compressed so a walkthrough finishes
# in one sitting. Compress via this parameter only — never by bypassing the
# scheduler, or the walkthrough stops demonstrating the thing it exists to show.
PII_ERASURE_GRACE_WINDOW_SECONDS=120
PII_ERASURE_APPROVAL_TIMEOUT_SECONDS=3600

# ─── Object Lock retention on the dev archive bucket ──────────────────────────
# ⚠️ COMPLIANCE mode means the bucket CANNOT be emptied or deleted until this
# elapses — not by you, not by root. Keep it short in dev, or you have created
# infrastructure you cannot tear down. See infra/README.md.
PII_ERASURE_DEV_OBJECT_LOCK_DAYS=1

# ─── Observability ────────────────────────────────────────────────────────────
# AgentCore Observability captures the agent's spans natively; the Lambda planes
# export OTel to the same CloudWatch destination. thread_id == sagaId == trace key.
OTEL_SERVICE_NAME=pii-erasure
PII_ERASURE_LOG_LEVEL=INFO

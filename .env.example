# ─── Model provider ───────────────────────────────────────────────────────────
# Bedrock via langchain-aws ChatBedrockConverse.
AWS_REGION=us-west-2
PII_ERASURE_MODEL_ID=us.anthropic.claude-sonnet-4-6-20250929-v1:0

# 1 = deterministic stub model. No AWS account, no cost. Used by CI and `make demo`.
PII_ERASURE_OFFLINE=1

# ─── Checkpointer (ADR-014: this is the system of record) ─────────────────────
# sqlite = local dev. postgres = production (Aurora Serverless v2).
PII_ERASURE_CHECKPOINTER=sqlite
PII_ERASURE_SQLITE_PATH=.state/checkpoints.sqlite
# PII_ERASURE_POSTGRES_URI=postgresql://user:pass@aurora-endpoint:5432/erasure

# ─── Runtime ──────────────────────────────────────────────────────────────────
PII_ERASURE_TENANT=meridian
PII_ERASURE_STATE_DIR=.state
PII_ERASURE_LOG_LEVEL=INFO

# ─── Policy ───────────────────────────────────────────────────────────────────
# LOG_ONLY records what would have been denied without blocking. Always start here.
PII_ERASURE_POLICY_MODE=ENFORCING
# Optional: AgentCore Gateway ARN. Unset = local policy engine only (ADR-005).
# PII_ERASURE_GATEWAY_ARN=

# ─── Timers (ADR-014: EventBridge Scheduler in prod, in-process locally) ──────
PII_ERASURE_SCHEDULER=local
# PII_ERASURE_SCHEDULER_ROLE_ARN=
# PII_ERASURE_RESUME_LAMBDA_ARN=

# Real deployments use 2592000 (30 days). Compressed so the demo finishes in one sitting.
PII_ERASURE_GRACE_WINDOW_SECONDS=10
PII_ERASURE_APPROVAL_TIMEOUT_SECONDS=300

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=pii-erasure
# Optional LangSmith tracing. Off by default — CloudWatch/OTel is the AWS-native path.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

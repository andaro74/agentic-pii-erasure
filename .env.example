# ─── This file configures the CLI and the deploy. It holds no secrets. ────────
# Authentication is SigV4 from your ambient AWS credentials; the deployed
# components assume IAM roles. Never put an access key in here.
#
# ⏳ MARKERS. A variable marked "lands at Mx" is not read by anything yet — the
# milestone that consumes it has not been built (docs/ROADMAP.md). Setting one
# today does nothing, and that is a documented state rather than a bug you are
# hunting. tests/unit/test_env_example.py fails the build if a variable is
# neither consumed by the code nor carrying a marker, so this file cannot drift
# back into describing intentions it has no mechanism for (VALIDATION V4-1/V4-4).
#
# Most runtime configuration is NOT here — it comes from the deployed stack's
# outputs (Gateway ARN, table names, Runtime ARN). There is no local mode, so
# there is nothing to configure for one. See ADR-017.

# ─── Target account and region ────────────────────────────────────────────────
# Choose a region where BOTH Amazon Bedrock AgentCore and your chosen Claude
# model are available. The stack is regional; cross-region AgentCore is not a
# supported topology here.
#
# REQUIRED. `make bootstrap`, `make deploy-dev`, `make deploy` and
# `make destroy-dev` source this file and fail loudly if AWS_REGION is unset —
# they do not silently fall back to your profile's region, because a regional
# stack deployed to a region you did not choose fails at discovery time, long
# after the deploy reported success. The account comes from your credentials
# (`aws sts get-caller-identity`); only the region is chosen here.
#
# A variable already exported in your shell WINS over this file — that is how
# CI overrides AWS_REGION and PII_ERASURE_STAGE per run.
AWS_REGION=us-west-2

# Names the stack instance: asdp-<stage>-foundation. Override per invocation
# with `make deploy-dev STAGE=sandbox`. This — not a stack-name prefix — is how
# two deployments in one account stay separate; a configurable prefix would let
# a second deploy quietly UPDATE the first one's stack, which is V3-1's failure
# shape in different clothes.
PII_ERASURE_STAGE=dev

# The fabricated tenant whose subjects `make seed` writes. ⏳ lands at M4.
PII_ERASURE_TENANT=meridian

# ─── SES sandbox (V8-11) ──────────────────────────────────────────────────────
# New AWS accounts cannot write SES suppression entries until production access
# is granted (SES console -> Account dashboard -> Request production access), so
# `make seed` fails by design: notify-suppression is invariant 7's worked
# example, and silently seeding without its suppression entry would leave the
# RESIDUAL_BY_DESIGN archetype undemonstrated while looking complete.
#
# Set to 1 to seed anyway. The gap is then recorded in the ground-truth map's
# `degraded` block — explicit, opt-in, and visible to later readers, never
# silent. Leave EMPTY once production access is granted; the flag is harmless
# then (the suppression write simply succeeds) but an empty value documents
# that the account is no longer degraded. Per-run override: make seed ALLOW_SES_SANDBOX=1
ALLOW_SES_SANDBOX=

# ─── Model ────────────────────────────────────────────────────────────────────
# REQUIRED — there is deliberately no default. The correct value depends on your
# region and on which models your account has been granted access to (Bedrock
# requires per-account, per-model opt-in). List what is actually available:
#
#   aws bedrock list-inference-profiles --region "$AWS_REGION"
#
# Then paste the inference profile ID for a current Claude Sonnet or Opus model.
# langchain-aws ChatBedrockConverse uses the bedrock-runtime Converse API, whose
# identifiers are region-prefixed cross-region inference profiles.
# A wrong or unentitled ID no longer fails discovery: `discovery/advisor.py` degrades
# to no scope hints and reports it in the response's `degraded` list. Recall is a
# structural property of the exhaustive sweep, so a missing model costs DEPTH (fewer
# alternate keys probed) and never COMPLETENESS.
#
# Leaving this EMPTY is a supported configuration — discovery runs deterministically.
# Set it to widen the search. Find one with:
#   aws bedrock list-inference-profiles --region "$AWS_REGION"
PII_ERASURE_MODEL_ID=

# ─── Policy (ADR-018) ─────────────────────────────────────────────────────────
# LOG_ONLY records what WOULD have been denied without blocking. Always start
# here, run the eval corpus, and flip only when the deny set is empty against
# known-good trajectories (ARCHITECTURE §9.4). This is a stack parameter, so
# flipping it is a deploy and lands in CloudTrail. ⏳ lands at M6.
PII_ERASURE_POLICY_MODE=LOG_ONLY

# ─── Timers (ADR-016: EventBridge Scheduler owns wall-clock) ──────────────────
# Real deployments use 2592000 (30 days). Compressed so a walkthrough finishes
# in one sitting. Compress via this parameter only — never by bypassing the
# scheduler, or the walkthrough stops demonstrating the thing it exists to show.
# ⏳ lands at M5 (grace window) and M8 (approval timeout).
PII_ERASURE_GRACE_WINDOW_SECONDS=120
PII_ERASURE_APPROVAL_TIMEOUT_SECONDS=3600

# ─── Object Lock retention on the dev archive bucket ──────────────────────────
# ⚠️ COMPLIANCE mode means the bucket CANNOT be emptied or deleted until this
# elapses — not by you, not by root. Keep it short in dev, or you have created
# infrastructure you cannot tear down. See infra/README.md.
PII_ERASURE_DEV_OBJECT_LOCK_DAYS=1

# ─── Observability ────────────────────────────────────────────────────────────
# AgentCore Observability captures the agent's spans natively; the Lambda planes
# export OTel to the same CloudWatch destination. thread_id == sagaId == trace key.
# ⏳ OTEL_SERVICE_NAME lands at M10, with `infra/stacks/observability.py` and the first
# exporter. It said M7 until M7 closed without one: the Runtime's spans are captured by
# AgentCore Observability natively, so nothing in M7 needed a first-party exporter, and
# the Lambda planes still export nothing. The variable is set and unread until then.
OTEL_SERVICE_NAME=pii-erasure
PII_ERASURE_LOG_LEVEL=INFO
